# 开放平台 Access Key Id（必填）
BILIBILI_ACCESS_KEY_ID=

# 开放平台 Access Key Secret（必填）
BILIBILI_ACCESS_KEY_SECRET=

# 项目 ID，必须是大于 0 的 i64（必填）
BILIBILI_APP_ID=

# 身份码（本项目中仅用于示例程序测试，不要泄露）
# AUTH_CODE=

# 直播桥监听地址（可选，默认 127.0.0.1:8080）
# BRIDGE_LISTEN=127.0.0.1:8080

# 官方 WebSocket 心跳间隔，单位秒（可选，默认 20，必须小于 30）
# BRIDGE_WEBSOCKET_HEARTBEAT_SECS=20

# 官方长连接发送期限与有效入站活动期限，单位秒（默认 5 / 60）
# 活动期限必须大于 WebSocket 心跳间隔加发送期限
# BRIDGE_WEBSOCKET_WRITE_TIMEOUT_SECS=5
# BRIDGE_WEBSOCKET_ACTIVITY_TIMEOUT_SECS=60

# 原场次上游恢复预算，单位秒（默认 120；0 禁用重连）
# BRIDGE_UPSTREAM_RECONNECT_TIMEOUT_SECS=120
# 上游恢复退避，单位毫秒（默认 2000 / 10000，初始值不得超过上限）
# BRIDGE_UPSTREAM_RECONNECT_RETRY_INITIAL_MS=2000
# BRIDGE_UPSTREAM_RECONNECT_RETRY_MAX_MS=10000

# 项目心跳间隔，单位秒（可选，默认 20，必须小于 60）
# BRIDGE_APP_HEARTBEAT_SECS=20

# 项目心跳恢复期限，从最后确认成功起算，单位秒（可选，默认 45）
# 首次失败后启用；超过 45 或与间隔/10 秒请求超时组合不安全时仅警告，保留原值
# BRIDGE_APP_HEARTBEAT_FAILURE_TIMEOUT_SECS=45

# 普通重试初始退避及上限，单位毫秒（可选，默认 2000 / 10000）
# 指数退避加入 ±20% 抖动并按上限封顶；访问受限时至少等待一个正常心跳间隔
# BRIDGE_APP_HEARTBEAT_RETRY_INITIAL_MS=2000
# BRIDGE_APP_HEARTBEAT_RETRY_MAX_MS=10000

# 日志过滤（可选，默认 info；支持模块级别，例如 info,bilibili_live_bridge=debug）
# RUST_LOG=info

# 有界内存事件日志（全部房间共享；不跨进程重启保留）
# 保留时间默认 300 秒，日志字节预算默认 32 MiB，流数量上限默认 128
# BRIDGE_EVENT_RETENTION_SECS=300
# BRIDGE_EVENT_LOG_MAX_BYTES=33554432
# BRIDGE_EVENT_LOG_MAX_STREAMS=128
# 每条 ACK 连接最多未确认事件数（默认 64）
# BRIDGE_ACK_WINDOW=64
