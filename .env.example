# 开放平台 Access Key Id（必填）
BILIBILI_ACCESS_KEY_ID=

# 开放平台 Access Key Secret（必填）
BILIBILI_ACCESS_KEY_SECRET=

# 项目 ID，必须是大于 0 的 i64（必填）
BILIBILI_APP_ID=

# 身份码（本项目中仅用于示例程序测试，不要泄露）
# AUTH_CODE=

# 直播桥监听地址（可选，默认 127.0.0.1:8080）
# BRIDGE_LISTEN=127.0.0.1:8080

# 官方 WebSocket 心跳间隔，单位秒（可选，默认 20，必须小于 30）
# BRIDGE_WEBSOCKET_HEARTBEAT_SECS=20

# 项目心跳间隔，单位秒（可选，默认 20，必须小于 60）
# BRIDGE_APP_HEARTBEAT_SECS=20

# 日志过滤（可选，默认 info；支持模块级别，例如 info,bilibili_live_bridge=debug）
# RUST_LOG=info